# Copy to .env and fill in. Never commit .env.

# SQLite path inside the container / local data dir
NORA_DATABASE_URL=sqlite:////data/nora.sqlite3

# Fernet key for encrypting per-routine Claude tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NORA_ENCRYPTION_KEY=

# Scheduler timezone (IANA name)
NORA_TZ=UTC

# Optional defaults used when a Nora job does not set its own fire URL / token.
# Per-routine URL + token from claude.ai/code/routines (API trigger modal).
CLAUDE_ROUTINE_FIRE_URL=
CLAUDE_ROUTINE_TOKEN=

# Optional: Anthropic API version header (default 2023-06-01)
ANTHROPIC_VERSION=2023-06-01

# Bind address used by uvicorn in Docker
NORA_HOST=0.0.0.0
NORA_PORT=8080
